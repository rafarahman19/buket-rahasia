# ==============================================================================
# BUKET RAHASIA — ENVIRONMENT VARIABLES
# Copy this file to `.env.local` for local development and configure all values
# in Vercel Project Settings -> Environment Variables for production.
# ==============================================================================

# 1. Public App URL (no trailing slash)
# Used for email reveal links, signed unsubscribe URLs, and Origin CSRF checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Cloudflare Turnstile (Bot Protection)
# For local testing, Cloudflare provides official always-pass test keys:
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
# Replace with real production widget keys from Cloudflare Dashboard before deploy!
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# 3. Supabase (Postgres Database + Storage)
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is strictly server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key"
SUPABASE_STORAGE_BUCKET="bouquet-previews"

# 4. Resend (Transactional Email)
# EMAIL_FROM must use a domain verified in Resend with SPF, DKIM, and DMARC configured.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Buket Rahasia <hai@yourdomain.com>"

# 5. Upstash Redis (Distributed Sliding-Window Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 6. Cryptographic Secrets (Generate each with: `openssl rand -base64 48`)
# HASH_PEPPER: >= 32 chars. Mixed into SHA-256 hashes of recipient emails & sender IPs.
HASH_PEPPER="replace-with-random-secret-at-least-32-characters-long"

# HMAC_SECRET: >= 32 chars. Signs & verifies recipient opt-out / block tokens.
HMAC_SECRET="replace-with-another-random-secret-at-least-32-chars"

# CRON_SECRET: >= 24 chars. Sent automatically by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="replace-with-cron-secret-at-least-24-chars"
